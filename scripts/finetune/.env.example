# ── Hope.Agent Fine-Tune Service — environment ──────────────────────────────
# All settings use the HOPE_FT_ prefix.

# Server
HOPE_FT_HOST=0.0.0.0
HOPE_FT_PORT=8765
HOPE_FT_API_KEY=change-me-strong-random-key
HOPE_FT_LOG_LEVEL=INFO
HOPE_FT_LOG_JSON=true

# Hope.Agent API
HOPE_FT_AGENT_API_URL=http://hope-agent-api:5000
HOPE_FT_AGENT_API_TOKEN=

# Training defaults
HOPE_FT_BASE_MODEL=Qwen/Qwen3-8B
HOPE_FT_LOAD_IN_4BIT=true
HOPE_FT_MAX_SEQ_LENGTH=2048

# Evaluation gate (champion vs challenger)
HOPE_FT_EVAL_MIN_SAMPLES=50
HOPE_FT_EVAL_WIN_RATE_PROMOTE=0.55
HOPE_FT_EVAL_JUDGE_MODEL=qwen2.5:7b-instruct
HOPE_FT_EVAL_JUDGE_URL=http://ollama:11434

# Continuous learning
HOPE_FT_AUTO_TRAIN_ENABLED=true
HOPE_FT_AUTO_TRAIN_CRON=0 3 * * *
HOPE_FT_AUTO_TRAIN_MIN_NEW_PAIRS=200

# Ollama integration
HOPE_FT_OLLAMA_URL=http://ollama:11434
HOPE_FT_OLLAMA_AUTO_REGISTER=true

# Safety
HOPE_FT_MAX_CONCURRENT_JOBS=1
HOPE_FT_MAX_RUNTIME_HOURS=12
