{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=hope_agent;Username=hope;Password=hope",
    "Redis": "localhost:6379"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Collection": "agent_memory"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "OpenApi": {
    "EnabledInProduction": false
  },
  "Jwt": {
    "Issuer": "hope.agent",
    "Audience": "hope.agent.api",
    "Secret": "dev-secret-please-change-32-chars-minimum-length"
  },
  "KeyVault": {
    "VaultName": "",
    "Enabled": false
  },
  "Cors": {
    "AllowedDomains": [
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "AgentRuntime": {
    "MaxToolIterations": 6,
    "MemoryTopK": 5
  },
  "LLM": {
    "DefaultChatProvider": "openai",
    "DefaultEmbeddingProvider": "openai",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "Qwen": {
      "BaseUrl": "http://localhost:8000/v1",
      "ApiKey": "",
      "Model": "Qwen/Qwen3-8B-Instruct",
      "EmbeddingModel": "Qwen/Qwen3-Embedding-0.6B"
    },
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest"
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-2.0-flash",
      "EmbeddingModel": "text-embedding-004"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2"
    }
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 5,
    "RefreshTokenLifetimeDays": 7,
    "ServiceAccounts": []
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "SecurityTxt": {
    "Contact": "mailto:security@hope.hospital.com",
    "Policy": "https://hope.hospital.com/security-policy",
    "Acknowledgments": "",
    "PreferredLanguages": "en, vi"
  },
  "AllowedHosts": "*",
  "ScheduledTasks": {
    "Enabled": false,
    "Tasks": [
      {
        "Name": "morning-or-briefing",
        "TimeUtc": "00:00",
        "DaysOfWeek": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ],
        "Prompt": "Hãy tóm tắt lịch phòng mổ hôm nay {date} ({dow}) và các ca nhập viện đang chờ xử lý. Trình bày ngắn gọn, phù hợp xem trên điện thoại.",
        "AgentProfile": "clinical-mobile"
      }
    ]
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "AllowedChatIds": [],
    "AgentProfile": "clinical-mobile",
    "MaxReplyLength": 3000
  },
  "Webhook": {
    "Secret": "",
    "TimestampToleranceSeconds": 300
  },
  "ToolApproval": {
    "Enabled": false,
    "DefaultImpact": "ReadOnly",
    "TimeoutSeconds": 30,
    "SandboxToolTimeoutMs": 30000,
    "SandboxMaxArgumentsBytes": 65536,
    "SandboxMaxOutputBytes": 262144,
    "Tools": {
      "patient_lookup": "ReadOnly",
      "clinical_guideline_search": "ReadOnly",
      "insurance_verify": "ReadOnly",
      "appointment_schedule": "Write"
    }
  },
  "Channels": {
    "Zalo": {
      "Enabled": false,
      "AppSecret": "",
      "OaAccessToken": "",
      "ApiBaseUrl": "https://openapi.zalo.me",
      "AllowedSenderIds": [],
      "AgentProfile": "clinical-mobile",
      "MaxReplyLength": 2000
    },
    "Slack": {
      "Enabled": false,
      "SigningSecret": "",
      "BotToken": "",
      "ApiBaseUrl": "https://slack.com/api",
      "AllowedChannelIds": [],
      "AgentProfile": "clinical-mobile",
      "MaxReplyLength": 3000,
      "MaxRequestSkewSeconds": 300
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "Hope Agent",
      "DefaultSubject": "Hope Agent notification",
      "TimeoutSeconds": 15
    }
  },
  "UserModel": {
    "Enabled": false,
    "ExtractEveryTurns": 10,
    "RecentTurnsWindow": 30
  },
  "SessionInsights": {
    "Enabled": false,
    "IntervalDays": 7,
    "RunHourUtc": 2,
    "MaxConversationsPerSummary": 50
  },
  "ConversationCompressor": {
    "Enabled": false,
    "TriggerMessageCount": 40,
    "KeepRecentMessages": 12
  },
  "SkillSelfImprovement": {
    "Enabled": false,
    "RewardThreshold": 0.7,
    "MinUsage": 5,
    "MaxRevisionsPerRun": 20,
    "IntervalHours": 24,
    "RunHourUtc": 3
  },
  "Subagents": {
    "Enabled": false,
    "MaxParallelism": 5,
    "PerBranchTimeoutSeconds": 60,
    "AggregationPrompt": "You are aggregating opinions from multiple specialist clinical sub-agents. Synthesize their answers into a single concise, well-cited recommendation. Note disagreements explicitly."
  },
  "Speech": {
    "Enabled": false,
    "Provider": "openai",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "SttModel": "whisper-1",
    "TtsModel": "tts-1",
    "TtsVoice": "alloy",
    "TtsFormat": "mp3",
    "TimeoutSeconds": 60
  },
  "TrajectoryExport": {
    "Enabled": false,
    "DefaultMaxConversations": 500
  },
  "FineTuning": {
    "TrainingApiUrl": "http://localhost:8765",
    "ApiKey": "",
    "DefaultBaseModel": "Qwen/Qwen3-8B",
    "AutoRegisterEloThreshold": 1050.0
  },
  "Kanban": {
    "Enabled": false
  },
  "ClinicalContext": {
    "Enabled": false,
    "Directory": "./context",
    "CacheSeconds": 60,
    "MaxCharacters": 4000
  },
  "Migration": {
    "Enabled": false,
    "MaxItemsPerImport": 5000
  },
  "Governance": {
    "Policies": {
      "PolicyPaths": [ "policies/routing/allowed-intents.yaml" ],
      "PhiMarkers": [ "ssn", "social security", "credit card", "passport" ],
      "InjectionDetectionSensitivity": "High",
      "EmergencyTriggers": [
        "stroke", "đột quỵ",
        "myocardial infarction", "nhồi máu cơ tim", "heart attack",
        "sepsis", "nhiễm khuẩn huyết",
        "cardiac arrest", "ngừng tim",
        "respiratory failure", "suy hô hấp",
        "code blue", "cấp cứu ngay",
        "immediate emergency", "life-threatening"
      ]
    }
  }
}
