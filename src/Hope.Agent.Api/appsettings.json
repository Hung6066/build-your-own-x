{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=hope_agent;Username=hope;Password=hope",
    "PostgresReadReplica": "Host=localhost;Port=5433;Database=hope_agent;Username=hope;Password=hope",
    "Redis": "localhost:6379"
  },
  "StorageEncryption": {
    "RequireAtRestEncryption": true,
    "AtRestEnabled": false,
    "Provider": "local-dev"
  },
  "RedisHa": {
    "Enabled": false,
    "ServiceName": "mymaster",
    "Endpoints": []
  },
  "Temporal": {
    "TargetHost": "localhost:7233",
    "TargetHosts": [ "localhost:7233" ],
    "Namespace": "default",
    "TaskQueue": "hope-agent-clinical",
    "WorkflowVersion": "v1",
    "EnforceWorkflowVersionGate": true,
    "AllowedWorkflowVersions": [ "v1" ],
    "EnableCanaryMultiVersionRollout": false,
    "CanaryAllowedWorkflowVersions": [ "v1" ],
    "CutoverAtUtc": null,
    "AutoBlockPreviousVersionsAfterCutover": true,
    "EnableWorker": false
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Collection": "agent_memory",
    "RequireTenantPayloadFilter": false,
    "TenantPayloadKey": "tenant_id"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "SecurityProtocol": "Plaintext"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "OpenApi": {
    "EnabledInProduction": false
  },
  "Jwt": {
    "Issuer": "hope.agent",
    "Audience": "hope.agent.api",
    "Secret": "dev-secret-please-change-32-chars-minimum-length"
  },
  "KeyVault": {
    "VaultName": "",
    "Enabled": false
  },
  "ZeroTrust": {
    "RequireMtls": false,
    "RequireWorkloadIdentity": false,
    "RequireShortLivedInternalJwt": true,
    "InternalJwtMaxLifetimeMinutes": 10,
    "RequiredMtlsServices": [ "api", "worker", "kafka", "postgres", "redis", "qdrant", "temporal" ],
    "WorkloadIdentityProvider": "local-dev"
  },
  "Secrets": {
    "RequireExternalSecretProvider": false,
    "Provider": "LocalDevelopment",
    "RejectInlineProductionSecrets": false,
    "RequireKmsEnvelopeEncryption": false,
    "KmsKeyId": "local-dev-kek",
    "KeyRotationDays": 90,
    "EnableTenantCryptoShred": true
  },
  "DataPerimeter": {
    "RequirePostgresRls": true,
    "RequireTenantIdNotNull": true,
    "RequireQdrantTenantPayloadFilter": false,
    "RequireRedisKeyNamespace": true,
    "RedisKeyPrefix": "hope:dev",
    "RequireRedisAcl": false
  },
  "AuditImmutability": {
    "Enabled": true,
    "RequireWormArchive": false,
    "WormArchiveUri": "local://audit-worm-dev",
    "VerifyIntervalMinutes": 1440,
    "VerificationLookbackDays": 30
  },
  "Dlp": {
    "Enabled": true,
    "RedactPhiOnExternalChannels": true,
    "BlockPhiExportWithoutApproval": true,
    "PhiExportWatermark": "PHI EXPORT - APPROVED - AUDITED",
    "ExternalChannels": [ "slack", "email", "zalo" ]
  },
  "EgressPolicy": {
    "RequireAllowlist": false,
    "AllowedHosts": []
  },
  "PolicyAsCode": {
    "Enabled": true,
    "Engine": "cedar-lite",
    "BundlePath": "policies/security/policy-bundle.json",
    "BundleSignaturePath": "policies/security/policy-bundle.sig",
    "RequireSignedBundle": false,
    "SigningKeyId": "local-dev-policy-key",
    "SigningSecret": "local-dev-policy-signing-secret",
    "DefaultVersion": "security-policy-v1"
  },
  "RuntimeSandbox": {
    "RequireIsolationForWriteTools": false,
    "Mode": "in-process",
    "CpuMillicores": 500,
    "MemoryMb": 256,
    "NetworkEgressTimeoutMs": 10000,
    "HighRiskWorkerPool": "high-risk-tools",
    "KillSwitch": {},
    "ToolPools": {
      "export_audit_report": "high-risk-tools",
      "commit_booking": "clinical-write-tools"
    }
  },
  "EnterpriseDataPerimeter": {
    "Enabled": true,
    "DefaultRegion": "us",
    "AllowedRegions": [ "us", "vn" ],
    "RequirePurposeForPhi": true,
    "RequireBreakGlassReview": true,
    "BreakGlassReviewDueHours": 24,
    "PurposeAccess": {
      "treatment": [ "doctor", "nurse", "admin" ],
      "operations": [ "admin", "clinical_operations_owner" ],
      "audit": [ "admin", "compliance_officer", "ai_safety_officer" ],
      "research": [ "researcher", "admin" ]
    },
    "Tenants": {
      "00000000-0000-0000-0000-000000000000": {
        "Region": "us",
        "Classification": "Phi",
        "AllowedPurposes": [ "treatment", "operations", "audit" ],
        "AllowedProviders": [ "local", "openai" ],
        "RequireLocalModelForPhi": false
      }
    }
  },
  "SecureModelRouting": {
    "Enabled": true,
    "LocalFallbackProvider": "local",
    "GlobalModelAllowlist": [ "local", "openai" ],
    "PhiApprovedProviders": [ "local", "openai" ],
    "BlockCostLatencyRouterForPhi": true,
    "RiskProviderAllowlist": {
      "High": [ "local", "openai" ],
      "Critical": [ "local" ]
    }
  },
  "AdversarialSimulation": {
    "Enabled": true,
    "IntervalHours": 24,
    "TargetEnvironment": "staging",
    "Suites": [ "prompt_injection", "data_exfiltration", "unauthorized_tool_call", "privilege_escalation", "hallucinated_citation", "cross_tenant_leakage" ],
    "MinPassRate": 1.0,
    "ReplayAgainstCanary": true,
    "EmitDriftSignalOnFailure": true
  },
  "IncidentResponse": {
    "Enabled": true,
    "Runbooks": [ "data_leakage", "wrong_tool_execution", "compromised_token", "prompt_injection_campaign" ],
    "AutoDisableAutonomyOnSeverityHigh": true,
    "AutoDisableToolOnWrongExecution": true,
    "EnableForensicExport": true,
    "ForensicExportTarget": "object-storage://incident-forensics"
  },
  "Cors": {
    "AllowedDomains": [
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "AgentRuntime": {
    "MaxToolIterations": 6,
    "MemoryTopK": 5
  },
  "AgenticRag": {
    "Enabled": true,
    "MaxIterations": 3,
    "MaxCorporaPerRun": 6,
    "TopKPerCorpus": 8,
    "FinalKPerCorpus": 4,
    "MaxContextChars": 12000,
    "MinSufficiencyConfidence": 0.62,
    "RequireCitations": true,
    "TenantScopedRetrievalRequired": true,
    "CacheRetrievalResults": true,
    "Corpora": {
      "clinical_guidelines": { "Type": "document", "Collection": "clinical_guidelines", "Description": "Clinical guidelines, SOP, protocols and policy documents.", "SourceWeight": 1.0 },
      "patient_memory": { "Type": "memory", "Description": "Patient-scoped AI memory facts and prior clinical notes.", "SourceWeight": 0.92, "RequiresPatientId": true },
      "medical_summaries": { "Type": "medical_summary", "Description": "Persisted medical summaries and discharge or visit summaries.", "SourceWeight": 0.98, "RequiresPatientId": true },
      "reminders": { "Type": "reminder", "Description": "Medication and follow-up reminders, status and escalation history.", "SourceWeight": 0.9, "RequiresPatientId": true },
      "appointments": { "Type": "appointment", "Description": "Appointment bookings, slot history, doctors and reasons.", "SourceWeight": 0.86, "RequiresPatientId": true },
      "audit": { "Type": "audit", "Description": "Audit logs, compliance events, workflow and tool actions.", "SourceWeight": 0.82 },
      "conversation": { "Type": "conversation", "Description": "Conversation messages and previous user-agent interactions.", "SourceWeight": 0.78 }
    }
  },
  "PromptOptimization": {
    "Enabled": true,
    "DefaultSuites": [ "default", "security" ],
    "CandidateCount": 3,
    "MinPromotionDelta": 0.03,
    "AutoPromote": false,
    "IntervalHours": 24
  },
  "Autonomy": {
    "Enabled": true,
    "Mode": "SuggestOnly",
    "AutoExecuteMaxRisk": "Low",
    "MinConfidenceForAutoExecute": 0.85,
    "RequireApprovalForClinicalWrite": true,
    "RequireApprovalForPhiExport": true,
    "RequireApprovalForMedicationChange": true,
    "RequireApprovalForEmergencySeverityAtLeast": 4
  },
  "AutonomyDailyReview": {
    "Enabled": false,
    "TimeUtc": "00:30",
    "MaxPatientsPerRun": 100,
    "LookbackDays": 60,
    "Goal": "Daily autonomy review: evaluate old patient data and suggest safe follow-up actions."
  },
  "AutonomyLevel5": {
    "Enabled": false,
    "MaxActionsPerPatientPerDay": 3,
    "MaxTotalActionsPerDay": 1000,
    "AutoPauseFailureThresholdPerHour": 10,
    "RequireOutcomeVerification": true,
    "AllowClinicalCriticalAutonomy": false,
    "RequireEvalGateForAutoExecute": true,
    "MinEvalGatePassRate": 0.9,
    "MaxAllowedDriftScore": 0.25,
    "RequireSecondReviewForRiskAtLeast": "High",
    "EnableCompensation": true,
    "ConfidenceCalibrationWindowDays": 14
  },
  "AutonomyAgiLike": {
    "Enabled": false,
    "MaxGoalsPerRun": 25,
    "MinEvidenceItems": 2,
    "MinGoalConfidence": 0.72,
    "AutoCreateLearningFacts": true,
    "MaxGoalRisk": "Medium"
  },
  "LLM": {
    "DefaultChatProvider": "openai",
    "DefaultEmbeddingProvider": "openai",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "Qwen": {
      "BaseUrl": "http://localhost:8000/v1",
      "ApiKey": "",
      "Model": "Qwen/Qwen3-8B-Instruct",
      "EmbeddingModel": "Qwen/Qwen3-Embedding-0.6B"
    },
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest"
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-2.0-flash",
      "EmbeddingModel": "text-embedding-004"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2"
    }
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 5,
    "RefreshTokenLifetimeDays": 7,
    "ServiceAccounts": []
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "SecurityTxt": {
    "Contact": "mailto:security@hope.hospital.com",
    "Policy": "https://hope.hospital.com/security-policy",
    "Acknowledgments": "",
    "PreferredLanguages": "en, vi"
  },
  "AllowedHosts": "*",
  "ScheduledTasks": {
    "Enabled": false,
    "Tasks": [
      {
        "Name": "morning-or-briefing",
        "TimeUtc": "00:00",
        "DaysOfWeek": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ],
        "Prompt": "Hãy tóm tắt lịch phòng mổ hôm nay {date} ({dow}) và các ca nhập viện đang chờ xử lý. Trình bày ngắn gọn, phù hợp xem trên điện thoại.",
        "AgentProfile": "clinical-mobile"
      }
    ]
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "AllowedChatIds": [],
    "AgentProfile": "clinical-mobile",
    "MaxReplyLength": 3000
  },
  "Webhook": {
    "Secret": "",
    "TimestampToleranceSeconds": 300
  },
  "ToolApproval": {
    "Enabled": false,
    "DefaultImpact": "ReadOnly",
    "AllowUnconfiguredToolAccess": true,
    "TimeoutSeconds": 30,
    "SandboxToolTimeoutMs": 30000,
    "SandboxMaxArgumentsBytes": 65536,
    "SandboxMaxOutputBytes": 262144,
    "RequireIdempotencyKeyForWrites": true,
    "DefaultPerToolConcurrencyLimit": 25,
    "PerToolConcurrencyLimit": {
      "export_audit_report": 2,
      "commit_booking": 5,
      "create_reminder_record": 10
    },
    "Tools": {
      "patient_lookup": "ReadOnly",
      "search_clinical_guidelines": "ReadOnly",
      "verify_insurance": "ReadOnly",
      "map_specialty": "ReadOnly",
      "get_doctor_slots": "ReadOnly",
      "get_medication_schedule": "ReadOnly",
      "collect_audit_logs": "ReadOnly",
      "detect_audit_anomalies": "ReadOnly",
      "schedule_appointment": "Write",
      "commit_booking": "Write",
      "persist_medical_summary": "Write",
      "create_reminder_record": "Write",
      "update_reminder_status": "Write",
      "export_audit_report": "Critical"
    },
    "ToolRoleAccess": {
      "commit_booking": [ "doctor", "nurse", "admin" ],
      "persist_medical_summary": [ "doctor", "admin" ],
      "create_reminder_record": [ "doctor", "nurse", "admin" ],
      "update_reminder_status": [ "doctor", "nurse", "admin" ],
      "export_audit_report": [ "admin" ]
    }
  },
  "Governance": {
    "Ownership": {
      "DefaultResponsibleRole": "clinical_operations_owner",
      "DefaultApproverRole": "clinical_supervisor",
      "Agents": {
        "medical_summary": { "ResponsibleRole": "doctor", "ApproverRole": "doctor", "AccessRoles": [ "doctor", "admin" ], "EscalationRole": "clinical_supervisor" },
        "reminder": { "ResponsibleRole": "nurse", "ApproverRole": "doctor", "AccessRoles": [ "doctor", "nurse", "admin" ], "EscalationRole": "clinical_supervisor" },
        "audit": { "ResponsibleRole": "admin", "ApproverRole": "admin", "AccessRoles": [ "admin" ], "EscalationRole": "compliance_officer" },
        "autonomy": { "ResponsibleRole": "clinical_operations_owner", "ApproverRole": "clinical_supervisor", "AccessRoles": [ "doctor", "nurse", "admin" ], "EscalationRole": "ai_safety_officer" }
      }
    },
    "AccessMatrix": {
      "Endpoints": {
        "/v1/agent/*": [ "doctor", "nurse", "admin" ],
        "/v1/autonomy/*": [ "doctor", "nurse", "admin" ],
        "/v1/security/approvals/*": [ "doctor", "nurse", "admin" ],
        "/v1/learning/*": [ "admin", "ai_safety_officer" ],
        "/v1/harness/*": [ "admin", "ai_safety_officer", "clinical_operations_owner" ],
        "/v1/tools/*": [ "admin" ]
      },
      "Tables": {
        "agent_decisions": [ "doctor", "nurse", "admin", "ai_safety_officer" ],
        "autonomous_actions": [ "doctor", "nurse", "admin", "ai_safety_officer" ],
        "agent_memories": [ "doctor", "admin" ],
        "audit_logs": [ "admin", "compliance_officer", "ai_safety_officer" ],
        "tool_approval_requests": [ "doctor", "nurse", "admin" ],
        "autonomy_eval_gate_runs": [ "admin", "ai_safety_officer" ],
        "autonomy_drift_signals": [ "admin", "ai_safety_officer" ]
      }
    },
    "ApprovalSla": {
      "DefaultTimeoutSeconds": 45,
      "EscalateAfterSeconds": 300,
      "DefaultEscalationRole": "clinical_supervisor",
      "ByRisk": {
        "Medium": { "TimeoutSeconds": 300, "EscalateAfterSeconds": 900, "EscalationRole": "clinical_supervisor" },
        "High": { "TimeoutSeconds": 120, "EscalateAfterSeconds": 300, "EscalationRole": "ai_safety_officer" },
        "Critical": { "TimeoutSeconds": 60, "EscalateAfterSeconds": 120, "EscalationRole": "clinical_director" }
      }
    }
  },
  "AgentOps": {
    "AlertChannel": "slack:clinical-ai-alerts",
    "AlertRules": [
      { "Name": "prompt_injection_blocks", "Metric": "hope_prompt_shield_blocks_total", "Condition": "rate_5m > 5", "OwnerRole": "security", "Route": "slack" },
      { "Name": "tool_error_rate", "Metric": "hope_tool_errors_total", "Condition": "rate_5m > 10", "OwnerRole": "platform", "Route": "slack" },
      { "Name": "autonomy_not_ready", "Metric": "level5_readiness", "Condition": "ready == false", "OwnerRole": "clinical_operations_owner", "Route": "pagerduty" },
      { "Name": "eval_gate_fail", "Metric": "hope_eval_gate_passed", "Condition": "latest == 0", "OwnerRole": "ai_safety_officer", "Route": "pagerduty" },
      { "Name": "latency_p95", "Metric": "http_server_duration_p95_ms", "Condition": "p95_5m > 3000", "OwnerRole": "platform", "Route": "slack" },
      { "Name": "llm_cost_spike", "Metric": "hope_llm_cost_usd", "Condition": "rate_1h > budget_hourly_rate * 2", "OwnerRole": "finance_ops", "Route": "slack" },
      { "Name": "queue_backlog", "Metric": "hope_autonomous_actions_pending", "Condition": "value > Runtime.QueueBacklogWarningThreshold", "OwnerRole": "platform", "Route": "slack" },
      { "Name": "approval_timeout", "Metric": "hope_tool_approvals_pending_oldest_seconds", "Condition": "value > Governance.ApprovalSla.EscalateAfterSeconds", "OwnerRole": "clinical_operations_owner", "Route": "pagerduty" },
      { "Name": "blocked_tool_calls", "Metric": "hope_security_blocked_tool_calls_total", "Condition": "rate_5m > 5", "OwnerRole": "ai_safety_officer", "Route": "slack" },
      { "Name": "policy_denials", "Metric": "hope_security_policy_denials_total", "Condition": "rate_5m > 10", "OwnerRole": "ai_safety_officer", "Route": "slack" },
      { "Name": "prompt_injection_detected", "Metric": "hope_security_prompt_injection_detected_total", "Condition": "rate_5m > 5", "OwnerRole": "security", "Route": "slack" },
      { "Name": "phi_redaction_count", "Metric": "hope_security_phi_redactions_total", "Condition": "rate_5m > 20", "OwnerRole": "privacy_officer", "Route": "pagerduty" },
      { "Name": "cross_tenant_access_denied", "Metric": "hope_security_cross_tenant_access_denied_total", "Condition": "rate_5m > 0", "OwnerRole": "security", "Route": "pagerduty" },
      { "Name": "suspicious_autonomy_action", "Metric": "hope_security_suspicious_autonomy_actions_total", "Condition": "rate_5m > 0", "OwnerRole": "ai_safety_officer", "Route": "pagerduty" }
    ]
  },
  "AgentVersion": {
    "DeploymentVersion": "dev",
    "PromptVersion": "hope-runtime-prompt-v1",
    "ToolsetVersion": "hope-tools-v1",
    "PolicyVersion": "hope-policy-v1",
    "ModelRoutingVersion": "hope-routing-v1",
    "ModelVersion": "gpt-4o-mini"
  },
  "Runtime": {
    "EnableHostedServices": true,
    "ApiAcceptsBackgroundJobs": true,
    "MaxApiReplicas": 10,
    "MaxWorkerReplicas": 20,
    "QueueBacklogWarningThreshold": 1000,
    "ApprovalBacklogWarningThreshold": 100,
    "IngestionBacklogWarningThreshold": 1000,
    "DurableQueueBackend": "Temporal/Kafka",
    "LedgerQueueBackend": "Postgres",
    "PostgresQueueHighThroughputAllowed": false,
    "ReadReplicaConnectionName": "PostgresReadReplica",
    "QueueSchedulingMode": "weighted-fair-priority",
    "PerTenantWorkerShareFloorPercent": 5,
    "CriticalRiskPriorityBoost": 100
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 100,
    "PollSeconds": 5,
    "MaxAttempts": 5,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 300,
    "JitterSeconds": 5
  },
  "DatabaseScale": {
    "EnablePartitionMaintenance": true,
    "PartitionMonthsAhead": 3,
    "EnableRollups": true,
    "RollupIntervalMinutes": 15,
    "PreferReadReplicaForDashboard": true,
    "EnableWeightedFairQueue": true,
    "QueueTenantBatchLimit": 25
  },
  "TenantIsolation": {
    "RequireTenantIdForWrites": true,
    "EnforceTenantRbac": true,
    "RequireTenantScopedRetrieval": true,
    "DefaultTenantHeader": "X-Tenant-Id"
  },
  "CostControl": {
    "DefaultMonthlyTenantBudgetUsd": 500,
    "DefaultMonthlyAgentBudgetUsd": 100,
    "DefaultMonthlyWorkflowBudgetUsd": 100,
    "EnableRealtimeAlerts": true,
    "AutoDowngradeModelOnBudgetPressure": true,
    "AutoDowngradeModelOnHighLatency": true,
    "BudgetPressureThreshold": 0.8,
    "LatencyP95DowngradeThresholdMs": 3000,
    "TenantBudgetsUsd": {},
    "AgentBudgetsUsd": {},
    "WorkflowBudgetsUsd": {}
  },
  "DataLifecycle": {
    "MemoryRetentionDays": 365,
    "AuditRetentionDays": 2555,
    "EvalRetentionDays": 730,
    "DecisionRetentionDays": 2555,
    "PhiRedactionRequired": true,
    "ComplianceExportEnabled": true,
    "ComplianceDeleteEnabled": true,
    "RagTraceHotRetentionDays": 90,
    "ArchiveTarget": "object-storage"
  },
  "DeploymentSafety": {
    "Strategy": "canary",
    "RequireEvalGateBeforeDeploy": true,
    "EnableShadowTraffic": true,
    "CanaryTrafficPercent": 5,
    "AutoRollbackOnEvalFailure": true,
    "AutoRollbackOnOpsFailure": true
  },
  "AgentRegistry": {
    "Agents": {
      "medical_summary": {
        "OwnerRole": "doctor",
        "AllowedTools": [ "persist_medical_summary", "search_clinical_guidelines", "patient_lookup" ],
        "EvalSuites": [ "medical_summary", "safety" ],
        "PromptVersion": "medical-summary-v1",
        "ModelVersion": "gpt-4o-mini",
        "ToolsetVersion": "hope-tools-v1",
        "PolicyVersion": "clinical-guard-v1",
        "MaxAutonomyRisk": "Low",
        "WorkflowDag": "clinical_autonomy"
      },
      "reminder": {
        "OwnerRole": "nurse",
        "AllowedTools": [ "get_medication_schedule", "create_reminder_record", "update_reminder_status" ],
        "EvalSuites": [ "reminder", "safety" ],
        "PromptVersion": "reminder-v1",
        "ModelVersion": "gpt-4o-mini",
        "ToolsetVersion": "hope-tools-v1",
        "PolicyVersion": "clinical-guard-v1",
        "MaxAutonomyRisk": "Medium",
        "WorkflowDag": "clinical_autonomy"
      },
      "audit": {
        "OwnerRole": "admin",
        "AllowedTools": [ "collect_audit_logs", "detect_audit_anomalies", "export_audit_report" ],
        "EvalSuites": [ "audit", "safety" ],
        "PromptVersion": "audit-v1",
        "ModelVersion": "gpt-4o-mini",
        "ToolsetVersion": "hope-tools-v1",
        "PolicyVersion": "audit-guard-v1",
        "MaxAutonomyRisk": "Critical",
        "WorkflowDag": "audit_report"
      },
      "autonomy": {
        "OwnerRole": "clinical_operations_owner",
        "AllowedTools": [ "update_reminder_status", "create_reminder_record", "get_doctor_slots" ],
        "EvalSuites": [ "autonomy", "safety" ],
        "PromptVersion": "autonomy-v1",
        "ModelVersion": "gpt-4o-mini",
        "ToolsetVersion": "hope-tools-v1",
        "PolicyVersion": "controlled-autonomy-v1",
        "MaxAutonomyRisk": "Medium",
        "WorkflowDag": "clinical_autonomy"
      }
    }
  },
  "Orchestration": {
    "Dags": {
      "Workflows": {
        "clinical_autonomy": {
          "Nodes": [ "planner", "research", "reviewer", "executor", "outcome_verifier" ],
          "Edges": [ "planner->research", "research->reviewer", "reviewer->executor", "executor->outcome_verifier" ],
          "RequiredReviewers": [ "safety_reviewer", "clinical_guard_reviewer" ]
        },
        "audit_report": {
          "Nodes": [ "planner", "collector", "anomaly_detector", "report_writer", "admin_reviewer" ],
          "Edges": [ "planner->collector", "collector->anomaly_detector", "anomaly_detector->report_writer", "report_writer->admin_reviewer" ],
          "RequiredReviewers": [ "admin_reviewer" ]
        }
      }
    }
  },
  "Channels": {
    "Zalo": {
      "Enabled": false,
      "AppSecret": "",
      "OaAccessToken": "",
      "ApiBaseUrl": "https://openapi.zalo.me",
      "AllowedSenderIds": [],
      "AgentProfile": "clinical-mobile",
      "MaxReplyLength": 2000
    },
