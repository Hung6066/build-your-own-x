{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } }
  },
  "Jwt": {
    "Issuer": "hope.agent",
    "Audience": "hope.agent.api",
    "Secret": "dev-secret-please-change-32-chars-minimum-length",
    "CurrentSecret": "",
    "PreviousSecret": "",
    "KeyId": ""
  },
  "Otel": { "Endpoint": "http://localhost:4317" },
  "ReverseProxy": {
    "TrustedNetworks": [],
    "Routes": {
      "auth": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/v1/auth/{**catch-all}" },
        "RateLimiterPolicy": "default"
      },
      "agent": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/v1/agent/{**catch-all}" },
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "default"
      },
      "webhooks": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/v1/webhooks/{**catch-all}" },
        "RateLimiterPolicy": "default"
      },
      "openapi": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/openapi/{**catch-all}" }
      },
      "health": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/healthz" }
      },
      "health-live": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/healthz/{**catch-all}" }
      },
      "security-txt": {
        "ClusterId": "agent_api",
        "Match": { "Path": "/.well-known/security.txt" }
      }
    },
    "Clusters": {
      "agent_api": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "Version": "2", "VersionPolicy": "RequestVersionOrLower" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/healthz"
          }
        },
        "Destinations": {
          "api-1": { "Address": "http://api:8080/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
