<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Test naming conventions (underscores) and test-only patterns conflict with prod analyzers -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1812;CA1848;CA1305;CA1304;CA2234</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hope.Agent.Api\Hope.Agent.Api.csproj" />
  </ItemGroup>
</Project>
